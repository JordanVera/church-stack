# Database (MySQL). Example for PlanetScale / local MySQL.
DATABASE_URL="mysql://user:password@localhost:3306/church_stack"

# next-auth
NEXTAUTH_SECRET="replace-with-a-long-random-string"
NEXTAUTH_URL="http://localhost:3000"

# /dev console — comma-separated emails (no DB column).
# If empty, set ALLOW_DEV_CONSOLE=true for local signed-in access only.
# In Vercel production, ALLOW_DEV_CONSOLE alone is denied — use PLATFORM_DEV_EMAILS.
PLATFORM_DEV_EMAILS="admin@churchstack.example,jordan.vera96@gmail.com"
ALLOW_DEV_CONSOLE="true"

# Shared API URL used by apps/church-site (and Vercel env injection).
PLATFORM_API_URL="http://localhost:3000/api/trpc"

# Optional local church-site preview base (opened from /dev).
NEXT_PUBLIC_CHURCH_SITE_PREVIEW_URL="http://localhost:3001"

# Support — shown on public pages; also used as fallback for inbound notifications.
NEXT_PUBLIC_SUPPORT_EMAIL="gatherlystack@proton.me"
# Inbound address for owner support form notifications (defaults to NEXT_PUBLIC_SUPPORT_EMAIL).
PLATFORM_SUPPORT_EMAIL="gatherlystack@proton.me"

# YouTube Data API v3 — public sermons playlist fetch (platform apps/web).
# YOUTUBE_API_KEY=

# Resend — required for support form + plan-a-visit email notifications.
# 1. Create an account at https://resend.com
# 2. Add an API key below
# 3. Verify a sending domain OR use onboarding@resend.dev (sandbox: can only send to your Resend signup email until a domain is verified)
# 4. Notifications are delivered to PLATFORM_SUPPORT_EMAIL (gatherlystack@proton.me)
# RESEND_API_KEY=re_...
# RESEND_FROM_EMAIL="Gatherly Stack <notifications@yourdomain.com>"

# Vercel Blob — church logo uploads from dashboard Settings
# BLOB_READ_WRITE_TOKEN=

# Vercel automation (website provision from /dev)
# VERCEL_TOKEN=
# VERCEL_TEAM_ID=
# VERCEL_GIT_REPO=owner/church-stack
# VERCEL_GIT_REF=main
# VERCEL_CHURCH_SITE_ROOT=apps/church-site

# EAS / Expo automation (white-label builds from /dev)
# EXPO_TOKEN=
# EAS_PROJECT_ID=

# Stripe billing (Site / Growth / Custom subscriptions)
# STRIPE_SECRET_KEY=sk_test_...
# STRIPE_WEBHOOK_SECRET=whsec_...
# NEXT_PUBLIC_STRIPE_PUBLISHABLE_KEY=pk_test_...
# STRIPE_PRICE_SITE=price_...
# STRIPE_PRICE_GROWTH=price_...
# STRIPE_PRICE_CUSTOM=price_...
